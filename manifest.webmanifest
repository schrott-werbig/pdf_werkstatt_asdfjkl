{
  "name": "PDF Werkstatt",
  "short_name": "PDF Werkstatt",
  "description": "PDFs lesen, kommentieren, unterschreiben und bearbeiten – offline, alles bleibt auf dem Gerät.",
  "id": "./pdf-werkstatt.html",
  "start_url": "./pdf-werkstatt.html",
  "scope": "./",
  "display": "standalone",
  "background_color": "#e3e6e1",
  "theme_color": "#fbfbf8",
  "lang": "de-CH",
  "icons": [
    {"src": "icon-192.png", "sizes": "192x192", "type": "image/png"},
    {"src": "icon-512.png", "sizes": "512x512", "type": "image/png"},
    {"src": "icon-maskable.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable"}
  ],
  "file_handlers": [
    {
      "action": "./pdf-werkstatt.html",
      "accept": {"application/pdf": [".pdf"]},
      "icons": [{"src": "icon-192.png", "sizes": "192x192", "type": "image/png"}],
      "launch_type": "single-client"
    }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {"files": [{"name": "file", "accept": ["application/pdf", ".pdf", "image/*"]}]}
  }
}
